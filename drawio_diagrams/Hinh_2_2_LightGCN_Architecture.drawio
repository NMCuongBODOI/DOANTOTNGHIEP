        </mxCell>
        <mxCell id="i1_1" value="e&lt;sub&gt;i1&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; = Σ 1/√(d&lt;sub&gt;i&lt;/sub&gt;d&lt;sub&gt;u&lt;/sub&gt;) e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt;&#xa;(Gom thực khách từng gọi món)" 
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=10.5;fontStyle=1;" vertex="1" parent="1">
