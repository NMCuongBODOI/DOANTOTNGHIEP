        </mxCell>
        <mxCell id="u2_1" value="e&lt;sub&gt;u2&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; = Σ 1/√(d&lt;sub&gt;u&lt;/sub&gt;d&lt;sub&gt;i&lt;/sub&gt;) e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt;&#xa;(Học sở thích trực tiếp của u&lt;sub&gt;2&lt;/sub&gt;)" 
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=10.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="380" y="195" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note_l1" value="Học đặc trưng sở thích trực tiếp&#xa;(Chuẩn hóa đối xứng Laplacian Â)" 
          style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=10;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
