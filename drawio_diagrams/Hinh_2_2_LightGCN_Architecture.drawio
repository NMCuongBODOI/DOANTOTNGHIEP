        <!-- KHỐI 2: TẦNG 1 (1-HOP PROPAGATION) -->
        <mxCell id="frame_l1" value="TẦNG 1: GOM TỤ LÁNG GIỀNG 1-HOP&#xa;(E⁽¹⁾ = D⁻¹/² A D⁻¹/² E⁽⁰⁾)" 
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=11.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
