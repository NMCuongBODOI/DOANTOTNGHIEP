        <!-- KHỐI 3: TẦNG 2 (2-HOP COLLABORATIVE SIGNAL) -->
        <mxCell id="frame_l2" value="TẦNG 2: TÍN HIỆU CỘNG TÁC 2-HOP&#xa;(E⁽²⁾ = D⁻¹/² A D⁻¹/² E⁽¹⁾)" 
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=11.5;fontStyle=1;align=center;verticalAlign=top;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="700" y="55" width="270" height="240" as="geometry" />
        </mxCell>
        <mxCell id="u1_2" value="e&lt;sub&gt;u1&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt; (Chứa thông tin từ u&lt;sub&gt;2&lt;/sub&gt;&#xa;qua món ăn cầu nối i&lt;sub&gt;1&lt;/sub&gt;)" 
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=10.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="95" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="i1_2" value="e&lt;sub&gt;i1&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt; (Chứa tương quan món&#xa;thường được đặt chung)" 
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=10.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="145" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="u2_2" value="e&lt;sub&gt;u2&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt; (Chứa thông tin từ u&lt;sub&gt;1&lt;/sub&gt;&#xa;qua món ăn cầu nối i&lt;sub&gt;1&lt;/sub&gt;)" 
          style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=10.5;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="720" y="195" width="230" height="40" as="geometry" />
        </mxCell>
        <mxCell id="note_l2" value="Tự động học tín hiệu cộng tác gián tiếp&#xa;(Triệt tiêu hoàn toàn thiên lệch dữ liệu)" 
          style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontFamily=Times New Roman;fontSize=10;fontStyle=2;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="720" y="245" width="230" height="35" as="geometry" />
        </mxCell>

        <!-- Message passing arrows between Layer 0 and Layer 1 -->
        <mxCell id="p_i1_u1" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1_0" target="u1_1" />
        <mxCell id="p_u1_i1" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1_0" target="i1_1" />
        <mxCell id="p_u2_i1" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2_0" target="i1_1" />

        <!-- Message passing arrows between Layer 1 and Layer 2 -->
        <mxCell id="p_i11_u12" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="i1_1" target="u1_2" />
        <mxCell id="p_u11_i12" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u1_1" target="i1_2" />
        <mxCell id="p_u21_i12" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="u2_1" target="i1_2" />

        <!-- KHỐI 4: TỔNG HỢP READOUT (MEAN POOLING) -->
        <mxCell id="frame_pool" value="KHỐI TỔNG HỢP BIỂU DIỄN ĐA TẦNG (MEAN POOLING READOUT, K=2)&#xa;e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; ≡ z&lt;sub&gt;u&lt;/sub&gt; = 1/3 (e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt; + e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; + e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt;)   &amp;amp;   e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; ≡ z&lt;sub&gt;i&lt;/sub&gt; = 1/3 (e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(0)&lt;/sup&gt; + e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(1)&lt;/sup&gt; + e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;(2)&lt;/sup&gt;)&#xa;(Kết hợp tuyến tính trọng số đều: giữ lại khởi tạo tầng 0, sở thích tầng 1, tín hiệu cộng tác tầng 2 &amp; chống Over-smoothing)" 
          style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontFamily=Times New Roman;fontSize=11.5;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="80" y="330" width="860" height="75" as="geometry" />
        </mxCell>

        <!-- Connections from Layer 0, Layer 1, Layer 2 to Pooling -->
        <mxCell id="pool_c0" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.15;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame_l0" target="frame_pool" />
        <mxCell id="pool_c1" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame_l1" target="frame_pool" />
        <mxCell id="pool_c2" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame_l2" target="frame_pool" />

        <!-- KHỐI 5: PREDICTION & TOP-K RANKING -->
        <mxCell id="frame_pred" value="DỰ ĐOÁN ĐIỂM ƯA THÍCH &amp; TRÍCH XUẤT TOP-K MÓN ĂN&#xa;ŷ&lt;sub&gt;ui&lt;/sub&gt; = (e&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;)ᵀ · e&lt;sub&gt;i&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; = z&lt;sub&gt;u&lt;/sub&gt;ᵀ · z&lt;sub&gt;i&lt;/sub&gt;   |   Train Masking: ŷ&lt;sub&gt;ui&lt;/sub&gt; ← −∞ (∀ i ∈ ℐ&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt;)&#xa;──► Danh sách đề xuất: Î&lt;sub&gt;K&lt;/sub&gt; = argTop-K (i ∈ ℐ \ ℐ&lt;sub&gt;u&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt;) ŷ&lt;sub&gt;ui&lt;/sub&gt;" 
          style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;strokeWidth=2;fontColor=#000000;fontFamily=Times New Roman;fontSize=12;fontStyle=1;align=center;" vertex="1" parent="1">
          <mxGeometry x="150" y="445" width="720" height="65" as="geometry" />
        </mxCell>

        <mxCell id="c_pool_pred" style="endArrow=classic;html=1;rounded=0;strokeColor=#000000;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="frame_pool" target="frame_pred" />

      </root>
    </mxGraphModel>
